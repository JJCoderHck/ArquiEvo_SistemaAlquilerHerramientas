@model SistemaAlquilerHerramientas.Models.Reserva

@{
    var esAdministrador = User.IsInRole("Administrador");
    var correoUsuario = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value ?? User.Identity?.Name;
    var puedeVerReserva = esAdministrador || (!string.IsNullOrWhiteSpace(correoUsuario) && string.Equals(Model?.IdClienteNavigation?.Correo, correoUsuario, System.StringComparison.OrdinalIgnoreCase));
    ViewData["Title"] = "Detalle de reserva";
}

@if (!puedeVerReserva)
{
    <div class="view-head compact danger-head">
        <div>
            <span class="eyebrow">Acceso restringido</span>
            <h1>Reserva no disponible</h1>
            <p>Solo puedes consultar las reservas asociadas a tu cuenta.</p>
        </div>
    </div>
    <div class="view-actions">
        <a asp-controller="Home" asp-action="Dashboard">Volver al inicio</a>
    <a asp-action="Index">Volver al listado</a></div>
}
else
{
<div class="view-head compact">
    <div>
        <span class="eyebrow">Detalle</span>
        <h1>Detalle de reserva</h1>
        <p>Consulta la informacion registrada sin modificar los datos.</p>
    </div>
</div>

<div class="detail-shell">
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FechaInicio)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FechaInicio)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FechaDevolucionEstimada)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FechaDevolucionEstimada)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EstadoReserva)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EstadoReserva)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FechaRegistro)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FechaRegistro)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IdClienteNavigation)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IdClienteNavigation.IdCliente)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IdHerramientaNavigation)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IdHerramientaNavigation.IdHerramienta)
        </dd>
    </dl>
</div>
<div class="view-actions">
    @if (esAdministrador)
    {
        <a class="table-action table-action-edit" asp-action="Edit" asp-route-id="@Model?.IdReserva">Editar</a>
    }
    <a asp-action="Index">Volver al listado</a>
</div>
}


