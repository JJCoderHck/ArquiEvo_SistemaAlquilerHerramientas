@model SistemaAlquilerHerramientas.Models.Reserva

@{
    var esAdministrador = User.IsInRole("Administrador");
    ViewData["Title"] = "Editar reserva";
}

@if (!esAdministrador)
{
    <div class="view-head compact danger-head">
        <div>
            <span class="eyebrow">Acceso restringido</span>
            <h1>Reserva no editable</h1>
            <p>Los clientes pueden consultar sus reservas, pero no modificarlas.</p>
        </div>
    </div>
    <div class="view-actions">
        <a asp-controller="Home" asp-action="Dashboard">Volver al inicio</a>
    <a asp-action="Index">Volver al listado</a></div>
}
else
{
<div class="view-head compact">
    <div>
        <span class="eyebrow">Formulario</span>
        <h1>Editar reserva</h1>
        <p>Actualiza la informacion de la reserva seleccionada.</p>
    </div>
</div>
<div class="form-shell">
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdReserva" />
            <div class="form-group">
                <label asp-for="IdCliente" class="control-label"></label>
                <select asp-for="IdCliente" class="form-control" asp-items="ViewBag.IdCliente"></select>
                <span asp-validation-for="IdCliente" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IdHerramienta" class="control-label"></label>
                <select asp-for="IdHerramienta" class="form-control" asp-items="ViewBag.IdHerramienta"></select>
                <span asp-validation-for="IdHerramienta" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FechaInicio" class="control-label"></label>
                <input asp-for="FechaInicio" class="form-control" />
                <span asp-validation-for="FechaInicio" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FechaDevolucionEstimada" class="control-label"></label>
                <input asp-for="FechaDevolucionEstimada" class="form-control" />
                <span asp-validation-for="FechaDevolucionEstimada" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EstadoReserva" class="control-label"></label>
                <input asp-for="EstadoReserva" class="form-control" />
                <span asp-validation-for="EstadoReserva" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FechaRegistro" class="control-label"></label>
                <input asp-for="FechaRegistro" class="form-control" />
                <span asp-validation-for="FechaRegistro" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
</div>
<div class="view-actions"><a asp-action="Index">Volver al listado</a></div>

}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}


