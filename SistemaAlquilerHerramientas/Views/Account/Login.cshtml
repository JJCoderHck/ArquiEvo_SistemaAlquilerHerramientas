@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesi&oacute;n";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HerraTools - Iniciar Sesi&oacute;n</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        :root {
            --brand: #e95545;
            --brand-dark: #20252d;
            --accent: #f19a3e;
            --ink: #1f2933;
            --muted: #6b7280;
            --line: #dedede;
            --surface: rgba(255, 255, 255, 0.92);
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            color: var(--ink);
            background: #f7f7f5;
            font-family: Arial, Helvetica, sans-serif;
        }

        html {
            scroll-behavior: smooth;
        }

        .topbar {
            height: 88px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 28px;
            padding: 0 44px;
            background: rgba(255, 255, 255, 0.96);
            border-bottom: 1px solid rgba(31, 41, 51, 0.08);
            position: relative;
            z-index: 5;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #111827;
            text-decoration: none;
        }

        .brand-symbol {
            width: 54px;
            height: 34px;
            position: relative;
            flex: 0 0 54px;
        }

        .brand-symbol::before,
        .brand-symbol::after {
            content: "";
            position: absolute;
            top: 8px;
            width: 25px;
            height: 25px;
            transform: rotate(45deg);
            border-radius: 2px;
        }

        .brand-symbol::before {
            left: 2px;
            background: var(--brand-dark);
        }

        .brand-symbol::after {
            left: 22px;
            background: var(--brand);
        }

        .brand-name {
            display: block;
            font-size: 1.65rem;
            font-weight: 900;
            line-height: 0.9;
            letter-spacing: 0;
        }

        .brand-tagline {
            display: block;
            margin-top: 5px;
            font-size: 0.7rem;
            font-weight: 800;
            color: #111827;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: clamp(18px, 3vw, 54px);
            margin: 0;
            padding: 0;
            list-style: none;
            font-size: 0.92rem;
        }

        .nav-links a {
            color: #2f3742;
            text-decoration: none;
            font-weight: 600;
        }

        .nav-links a:hover,
        .nav-links a:focus {
            color: var(--brand);
        }

        .nav-cta {
            min-height: 42px;
            display: inline-flex;
            align-items: center;
            padding: 0 18px;
            color: #fff !important;
            background: #ef8e86;
            font-weight: 900 !important;
        }

        .nav-cta:hover,
        .nav-cta:focus {
            background: var(--brand);
        }

        .search-box {
            width: 190px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid #cfd3d8;
            color: #667085;
        }

        .search-box input {
            width: 100%;
            border: 0;
            outline: 0;
            padding: 8px 4px;
            background: transparent;
            color: #667085;
        }

        .hero {
            min-height: calc(100vh - 88px);
            display: grid;
            grid-template-columns: minmax(0, 1fr) 450px;
            gap: 64px;
            align-items: start;
            padding: 110px max(44px, calc((100vw - 1180px) / 2)) 70px;
            background:
                linear-gradient(90deg, rgba(248, 249, 249, 0.94) 0%, rgba(248, 249, 249, 0.78) 38%, rgba(248, 249, 249, 0.35) 100%),
                url("https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&w=1800&q=80");
            background-position: center;
            background-size: cover;
            position: relative;
        }

        .hero::after {
            content: "";
            position: absolute;
            inset: auto 0 0;
            height: 130px;
            background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.96));
            pointer-events: none;
        }

        .hero-copy,
        .login-card {
            position: relative;
            z-index: 2;
        }

        .eyebrow {
            color: var(--brand);
            font-size: 0.78rem;
            font-weight: 900;
            letter-spacing: 0.08rem;
            text-transform: uppercase;
        }

        .hero h1 {
            max-width: 560px;
            margin: 16px 0 14px;
            color: #20252d;
            font-size: clamp(2.55rem, 5vw, 4.6rem);
            font-weight: 900;
            line-height: 1.02;
        }

        .hero-copy p {
            max-width: 500px;
            margin: 0;
            color: #303846;
            font-size: 1.08rem;
            font-weight: 700;
            line-height: 1.45;
        }

        .quick-links {
            display: flex;
            flex-wrap: wrap;
            gap: 34px;
            margin-top: 48px;
            padding: 0;
            list-style: none;
        }

        .quick-links a {
            color: #20252d;
            text-decoration: none;
            font-size: 1rem;
            font-weight: 900;
        }

        .quick-links span {
            color: var(--brand);
        }

        .login-card {
            margin-top: 24px;
            padding: 42px;
            background: var(--surface);
            border: 1px solid rgba(31, 41, 51, 0.12);
            box-shadow: 0 22px 50px rgba(17, 24, 39, 0.16);
            backdrop-filter: blur(8px);
        }

        .login-card h2 {
            margin: 0 0 8px;
            color: #20252d;
            font-size: 1.45rem;
            font-weight: 900;
        }

        .login-card .subtitle {
            margin: 0 0 28px;
            color: var(--muted);
            font-size: 0.95rem;
            line-height: 1.55;
        }

        .form-label {
            color: #404956;
            font-size: 0.88rem;
            font-weight: 800;
        }

        .form-control {
            min-height: 48px;
            border-radius: 0;
            border: 1px solid var(--line);
            background: rgba(250, 250, 250, 0.86);
            color: #20252d;
            font-size: 0.96rem;
        }

        .form-control:focus {
            border-color: var(--brand);
            box-shadow: 0 0 0 0.2rem rgba(233, 85, 69, 0.16);
        }

        .login-button {
            min-height: 50px;
            width: fit-content;
            min-width: 128px;
            border: 0;
            border-radius: 0;
            padding: 0 26px;
            color: #fff;
            background: #ef8e86;
            font-weight: 900;
            transition: background 0.18s ease, transform 0.18s ease;
        }

        .login-button:hover,
        .login-button:focus {
            color: #fff;
            background: var(--brand);
            transform: translateY(-1px);
        }

        .form-actions {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 14px;
        }

        .register-link {
            color: #20252d;
            font-size: 0.9rem;
            font-weight: 900;
            text-decoration: none;
            border-bottom: 1px solid rgba(233, 85, 69, 0.45);
        }

        .register-link:hover,
        .register-link:focus {
            color: var(--brand);
        }

        .alert {
            border: 0;
            border-left: 4px solid var(--brand);
            border-radius: 0;
        }

        .field-validation-error,
        .text-danger {
            display: block;
            margin-top: 6px;
            color: #c0392b !important;
        }

        .support-note {
            margin: 24px 0 0;
            color: var(--muted);
            font-size: 0.86rem;
        }

        .public-section {
            padding: 76px max(28px, calc((100vw - 1180px) / 2));
            background: #fff;
            border-top: 1px solid rgba(31, 41, 51, 0.08);
        }

        .public-section.alt {
            background: #f7f7f5;
        }

        .public-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 34px;
            align-items: start;
        }

        .public-copy h2,
        .contact-card h2 {
            margin: 10px 0 12px;
            color: #20252d;
            font-size: clamp(1.8rem, 3vw, 2.6rem);
            font-weight: 900;
            line-height: 1.08;
        }

        .public-copy p,
        .contact-card p {
            margin: 0;
            color: #485160;
            font-weight: 700;
            line-height: 1.6;
        }

        .info-list {
            display: grid;
            gap: 14px;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .info-list li,
        .contact-card {
            padding: 22px;
            border: 1px solid var(--line);
            background: rgba(255, 255, 255, 0.92);
        }

        .info-list strong {
            display: block;
            margin-bottom: 8px;
            color: #20252d;
            font-weight: 900;
        }

        .contact-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 24px;
        }

        .contact-actions a {
            min-height: 46px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 20px;
            color: #20252d;
            text-decoration: none;
            border: 1px solid var(--line);
            background: #fff;
            font-weight: 900;
        }

        .contact-actions a.primary {
            color: #fff;
            border-color: #ef8e86;
            background: #ef8e86;
        }

        .contact-actions a:hover,
        .contact-actions a:focus {
            color: #fff;
            border-color: var(--brand);
            background: var(--brand);
        }

        @@media (max-width: 980px) {
            .topbar {
                height: auto;
                min-height: 78px;
                padding: 18px 24px;
                flex-wrap: wrap;
            }

            .nav-links {
                order: 3;
                width: 100%;
                justify-content: center;
                gap: 20px;
            }

            .search-box {
                width: 150px;
            }

            .hero {
                min-height: auto;
                grid-template-columns: 1fr;
                gap: 34px;
                padding: 64px 24px 48px;
            }

            .login-card {
                width: min(100%, 480px);
                margin-top: 0;
            }
        }

        @@media (max-width: 620px) {
            .topbar {
                align-items: flex-start;
            }

            .brand-name {
                font-size: 1.35rem;
            }

            .nav-links {
                display: none;
            }

            .hero {
                padding: 46px 18px 36px;
            }

            .hero h1 {
                font-size: 2.35rem;
            }

            .quick-links {
                gap: 18px;
                margin-top: 30px;
            }

            .login-card {
                padding: 28px 22px;
            }

            .public-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <header class="topbar">
        <a class="brand" href="#inicio" aria-label="Ir al inicio de HerraTools">
            <span class="brand-symbol" aria-hidden="true"></span>
            <span>
                <span class="brand-name">HerraTools</span>
                <span class="brand-tagline">Alquila herramientas sin fricci&oacute;n</span>
            </span>
        </a>

        <nav aria-label="Navegaci&oacute;n principal">
            <ul class="nav-links">
                <li><a href="#nosotros">Nosotros</a></li>
                <li><a href="#contacto">Contacto</a></li>
                <li><a asp-controller="Account" asp-action="Register">Registrarse</a></li>
                <li><a class="nav-cta" href="#login-panel">Iniciar sesi&oacute;n</a></li>
            </ul>
        </nav>
    </header>

    <main id="inicio" class="hero">
        <section class="hero-copy">
            <span class="eyebrow">Sistema de alquiler</span>
            <h1>Alquiler de herramientas para cada proyecto.</h1>
            <p>Administra inventario, reservas, clientes, devoluciones y moras desde una plataforma clara y lista para trabajar.</p>

            <ul class="quick-links" aria-label="Accesos destacados">
                <li><a href="#nosotros">Nosotros <span>&gt;</span></a></li>
                <li><a href="#contacto">Cont&aacute;ctanos <span>&gt;</span></a></li>
            </ul>
        </section>

        <section id="login-panel" class="login-card" aria-label="Formulario de inicio de sesi&oacute;n">
            <h2>&iquest;Listo para entrar?</h2>
            <p class="subtitle">Ingresa tus credenciales para acceder al panel de HerraTools.</p>

            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="alert alert-success mb-4" role="alert">
                    @successMessage
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mb-4" role="alert">
                    <strong>Credenciales incorrectas.</strong>
                    <span>Revisa tu correo o usuario y la contrase&ntilde;a.</span>
                    @Html.ValidationSummary(true)
                </div>
            }

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Context.Request.Query["returnUrl"]" />

                <div class="mb-3">
                    <label asp-for="Correo" class="form-label">Correo o usuario</label>
                    <input asp-for="Correo" class="form-control" autocomplete="username" placeholder="admin@herratools.com o admin" />
                    <span asp-validation-for="Correo" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Contrasena" class="form-label">Contrase&ntilde;a</label>
                    <input asp-for="Contrasena" class="form-control" type="password" autocomplete="current-password" placeholder="Ingresa tu contrase&ntilde;a" />
                    <span asp-validation-for="Contrasena" class="text-danger small"></span>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn login-button">Ingresar</button>
                    <a class="register-link" asp-controller="Account" asp-action="Register">Registrar nuevo usuario</a>
                </div>
            </form>

            <p class="support-note">Si todav&iacute;a no tienes una cuenta, registra tu usuario para solicitar acceso como cliente.</p>
        </section>
    </main>

    <section id="nosotros" class="public-section">
        <div class="public-grid">
            <div class="public-copy">
                <span class="eyebrow">Nosotros</span>
                <h2>Una plataforma para controlar el ciclo completo de alquiler.</h2>
                <p>HerraTools centraliza la gesti&oacute;n de herramientas, clientes, reservas, alquileres, devoluciones y moras para reducir errores y mantener la operaci&oacute;n ordenada.</p>
            </div>
            <ul class="info-list">
                <li>
                    <strong>Inventario actualizado</strong>
                    Herramientas organizadas por categor&iacute;a, proveedor, precio diario y estado.
                </li>
                <li>
                    <strong>Operaci&oacute;n trazable</strong>
                    Reservas, alquileres y devoluciones quedan registradas para facilitar el seguimiento.
                </li>
                <li>
                    <strong>Acceso por roles</strong>
                    Los usuarios ingresan con credenciales y ven las funciones correspondientes a su perfil.
                </li>
            </ul>
        </div>
    </section>

    <section id="contacto" class="public-section alt">
        <div class="contact-card">
            <span class="eyebrow">Contacto</span>
            <h2>Cont&aacute;ctanos</h2>
            <p>Para recuperar accesos, solicitar un cambio de rol o reportar datos incorrectos, comun&iacute;cate con el administrador del sistema.</p>
            <div class="contact-actions">
                <a class="primary" href="#login-panel">Iniciar sesi&oacute;n</a>
                <a href="mailto:soporte@herratools.com">soporte@herratools.com</a>
            </div>
        </div>
    </section>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>

