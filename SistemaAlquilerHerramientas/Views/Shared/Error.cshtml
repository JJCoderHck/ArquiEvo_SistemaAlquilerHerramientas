@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="dashboard-head">
    <span class="eyebrow">Error</span>
    <h1>No pudimos completar la solicitud</h1>
    <p>Ocurrio un problema mientras se procesaba la operacion. Intenta nuevamente o vuelve al inicio.</p>
</div>

@if (Model.ShowRequestId)
{
    <div class="notice-panel">
        <h2>Codigo de seguimiento</h2>
        <p><code>@Model.RequestId</code></p>
    </div>
}

<a class="module-card compact-action" asp-controller="Home" asp-action="Index">
    <strong>Volver al inicio</strong>
    <span>Regresar al panel principal de HerraTools</span>
</a>

