<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HerraTools</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SistemaAlquilerHerramientas.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    🔧 HerraTools
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>

                        @* Menú visible para todos los autenticados *@
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Herramientas" asp-action="Index">Herramientas</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Reserva" asp-action="Index">Reservas</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Alquilers" asp-action="Index">Alquileres</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Devolucion" asp-action="Index">Devoluciones</a>
                            </li>
                        }

                        @* Menú exclusivo para Administrador *@
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    Administración
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Reportes" asp-action="Index">Reportes</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Clientes" asp-action="Index">Clientes</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Proveedor" asp-action="Index">Proveedores</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="CategoriaHerramienta" asp-action="Index">Categorías</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Mora" asp-action="Index">Moras</a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Usuario" asp-action="Index">Usuarios</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Rol" asp-action="Index">Roles</a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>

                    @* Sección derecha: usuario y logout *@
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    👤 @User.Identity.Name
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <span class="badge bg-warning text-dark ms-1">Admin</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary ms-1">Cliente</span>
                                    }
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark">
                                    <li>
                                        <span class="dropdown-item-text text-muted small">
                                            @User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value
                                        </span>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                            🚪 Cerrar sesión
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">
                                    Iniciar sesión
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-4">
        <div class="container py-2 d-flex justify-content-between">
            <span>&copy; 2026 - HerraTools</span>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="small">
                    Sesión activa como <strong>@User.Identity.Name</strong>
                    (@(User.IsInRole("Administrador") ? "Administrador" : "Cliente"))
                </span>
            }
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>