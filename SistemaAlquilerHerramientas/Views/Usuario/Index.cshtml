@model IEnumerable<SistemaAlquilerHerramientas.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="view-head">
    <div>
        <span class="eyebrow">Listado</span>
        <h1>Usuarios</h1>
        <p>Administra credenciales, estado y rol asignado.</p>
    </div>
    <div class="view-actions">
        <a asp-controller="Home" asp-action="Dashboard">Volver al inicio</a>
        <a asp-action="Create" class="btn btn-primary">Nuevo registro</a>
    </div>
</div>
<div class="table-shell">
<table class="table app-table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Correo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Usuario1)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Contrasena)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Estado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdRolNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Correo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Usuario1)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Contrasena)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Estado)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdRolNavigation.IdRol)
            </td>
            <td>
                <a class="table-action table-action-edit" asp-action="Edit" asp-route-id="@item.IdUsuario">Editar</a> <a class="table-action table-action-view" asp-action="Details" asp-route-id="@item.IdUsuario">Ver</a> <a class="table-action table-action-delete" asp-action="Delete" asp-route-id="@item.IdUsuario">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>

