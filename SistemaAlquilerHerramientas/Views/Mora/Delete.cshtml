@model SistemaAlquilerHerramientas.Models.Mora

@{
    ViewData["Title"] = "Eliminar mora";
}

<div class="view-head compact danger-head">
    <div>
        <span class="eyebrow">Confirmacion</span>
        <h1>Eliminar mora</h1>
        <p>Revisa los datos antes de confirmar la eliminacion. Esta accion afectara el registro seleccionado.</p>
    </div>
</div>

<div class="detail-shell danger-shell">
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DiasRetraso)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DiasRetraso)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MontoMora)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MontoMora)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EstadoPago)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EstadoPago)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IdAlquilerNavigation)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IdAlquilerNavigation.IdAlquiler)
        </dd>
    </dl>
</div>
<form asp-action="Delete" class="view-actions danger-actions">
        <input type="hidden" asp-for="IdMora" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index">Volver al listado</a>
    </form>


