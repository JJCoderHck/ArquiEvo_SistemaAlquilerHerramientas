@model IEnumerable<SistemaAlquilerHerramientas.Models.Mora>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.DiasRetraso)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MontoMora)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EstadoPago)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdAlquilerNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.DiasRetraso)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MontoMora)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EstadoPago)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdAlquilerNavigation.IdAlquiler)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdMora">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdMora">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdMora">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
