@model IEnumerable<SistemaAlquilerHerramientas.Models.Devolucion>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FechaDevolucionReal)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EstadoRetorno)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Observacion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaRegistro)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdAlquilerNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FechaDevolucionReal)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EstadoRetorno)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Observacion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FechaRegistro)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdAlquilerNavigation.IdAlquiler)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdDevolucion">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdDevolucion">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdDevolucion">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
