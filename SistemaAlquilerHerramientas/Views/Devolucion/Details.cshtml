@model SistemaAlquilerHerramientas.Models.Devolucion

@{
    ViewData["Title"] = "Detalle de devolucion";
}

<div class="view-head compact">
    <div>
        <span class="eyebrow">Detalle</span>
        <h1>Detalle de devolucion</h1>
        <p>Consulta la informacion registrada sin modificar los datos.</p>
    </div>
</div>

<div class="detail-shell">
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FechaDevolucionReal)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FechaDevolucionReal)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EstadoRetorno)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EstadoRetorno)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Observacion)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Observacion)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FechaRegistro)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FechaRegistro)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IdAlquilerNavigation)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IdAlquilerNavigation.IdAlquiler)
        </dd>
    </dl>
</div>
<div class="view-actions">
        <a asp-controller="Home" asp-action="Dashboard">Volver al inicio</a>
    <a class="table-action table-action-edit" asp-action="Edit" asp-route-id="@Model?.IdDevolucion">Editar</a> <a asp-action="Index">Volver al listado</a>
</div>


