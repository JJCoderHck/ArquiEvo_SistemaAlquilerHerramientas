@model SistemaAlquilerHerramientas.Models.Alquiler

@{
    ViewData["Title"] = "Editar alquiler";
}

<div class="view-head compact">
    <div>
        <span class="eyebrow">Formulario</span>
        <h1>Editar alquiler</h1>
        <p>Actualiza la informacion del alquiler seleccionado.</p>
    </div>
</div>
<div class="form-shell">
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdAlquiler" />
            <div class="form-group">
                <label asp-for="IdCliente" class="control-label"></label>
                <select asp-for="IdCliente" class="form-control" asp-items="ViewBag.IdCliente"></select>
                <span asp-validation-for="IdCliente" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IdHerramienta" class="control-label"></label>
                <select asp-for="IdHerramienta" class="form-control" asp-items="ViewBag.IdHerramienta"></select>
                <span asp-validation-for="IdHerramienta" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IdReserva" class="control-label"></label>
                <select asp-for="IdReserva" class="form-control" asp-items="ViewBag.IdReserva"></select>
                <span asp-validation-for="IdReserva" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FechaEntrega" class="control-label"></label>
                <input asp-for="FechaEntrega" class="form-control" />
                <span asp-validation-for="FechaEntrega" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FechaDevolucionPactada" class="control-label"></label>
                <input asp-for="FechaDevolucionPactada" class="form-control" />
                <span asp-validation-for="FechaDevolucionPactada" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MontoEstimado" class="control-label"></label>
                <input asp-for="MontoEstimado" class="form-control" />
                <span asp-validation-for="MontoEstimado" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EstadoAlquiler" class="control-label"></label>
                <input asp-for="EstadoAlquiler" class="form-control" />
                <span asp-validation-for="EstadoAlquiler" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FechaRegistro" class="control-label"></label>
                <input asp-for="FechaRegistro" class="form-control" />
                <span asp-validation-for="FechaRegistro" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
</div>
<div class="view-actions">
        <a asp-controller="Home" asp-action="Dashboard">Volver al inicio</a>
    <a asp-action="Index">Volver al listado</a></div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}


