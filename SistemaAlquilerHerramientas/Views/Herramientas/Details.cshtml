@model SistemaAlquilerHerramientas.Models.Herramientum

@{
    ViewData["Title"] = "Detalle de herramienta";
    var imagenHerramienta = Url.Content($"~/images/herramientas/{Model.IdHerramienta}.png");
    var imagenDefault = Url.Content("~/images/no-image.png");
}

<div class="view-head compact">
    <div>
        <span class="eyebrow">Detalle</span>
        <h1>Detalle de herramienta</h1>
        <p>Consulta la informacion registrada sin modificar los datos.</p>
    </div>
</div>

<div class="detail-shell tool-detail-shell">
    <div class="tool-detail-layout">
        <section class="detail-grid" aria-label="Informacion de herramienta">
            <div class="detail-item">
                <span>Nombre</span>
                <strong>@Model.Nombre</strong>
            </div>
            <div class="detail-item">
                <span>Precio por dia</span>
                <strong>@Model.PrecioPorDia.ToString("C")</strong>
            </div>
            <div class="detail-item detail-item-wide">
                <span>Descripcion</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.Descripcion) ? "Sin descripcion" : Model.Descripcion)</strong>
            </div>
            <div class="detail-item">
                <span>Estado</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.EstadoHerramienta) ? "Sin estado" : Model.EstadoHerramienta)</strong>
            </div>
            <div class="detail-item">
                <span>Categoria</span>
                <strong>@(Model.IdCategoriaNavigation?.NombreCategoria ?? $"Categoria {Model.IdCategoria}")</strong>
            </div>
            <div class="detail-item">
                <span>Proveedor</span>
                <strong>@(Model.IdProveedorNavigation?.RazonSocial ?? $"Proveedor {Model.IdProveedor}")</strong>
            </div>
        </section>

        <aside class="tool-image-panel" aria-label="Imagen de herramienta">
            <img src="@imagenHerramienta"
                 alt="Imagen de @Model.Nombre"
                 onerror="this.onerror=null;this.src='@imagenDefault';" />
        </aside>
    </div>
</div>
<div class="view-actions">
        <a asp-controller="Home" asp-action="Dashboard">Volver al inicio</a>
    @if (User.IsInRole("Administrador"))
    {
        <a class="table-action table-action-edit" asp-action="Edit" asp-route-id="@Model?.IdHerramienta">Editar</a>
    }
    <a asp-action="Index">Volver al listado</a>
</div>


