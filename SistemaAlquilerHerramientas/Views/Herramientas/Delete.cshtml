@model SistemaAlquilerHerramientas.Models.Herramientum

@{
    ViewData["Title"] = "Eliminar herramienta";
}

<div class="view-head compact danger-head">
    <div>
        <span class="eyebrow">Confirmacion</span>
        <h1>Eliminar herramienta</h1>
        <p>Revisa los datos antes de confirmar la eliminacion. Esta accion afectara el registro seleccionado.</p>
    </div>
</div>

<div class="detail-shell danger-shell">
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Descripcion)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Descripcion)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PrecioPorDia)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PrecioPorDia)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EstadoHerramienta)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EstadoHerramienta)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IdCategoriaNavigation)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IdCategoriaNavigation.IdCategoria)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IdProveedorNavigation)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IdProveedorNavigation.IdProveedor)
        </dd>
    </dl>
</div>
<form asp-action="Delete" class="view-actions danger-actions">
        <input type="hidden" asp-for="IdHerramienta" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index">Volver al listado</a>
    </form>


