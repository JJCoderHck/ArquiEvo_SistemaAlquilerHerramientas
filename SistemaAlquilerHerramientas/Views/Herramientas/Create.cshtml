@model SistemaAlquilerHerramientas.Models.Herramientum

@{
    ViewData["Title"] = "Nuevo herramienta";
}

<div class="view-head compact">
    <div>
        <span class="eyebrow">Formulario</span>
        <h1>Nuevo herramienta</h1>
        <p>Completa los datos para registrar un nuevo herramienta.</p>
    </div>
</div>
<div class="form-shell">
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Nombre" class="control-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Descripcion" class="control-label"></label>
                <input asp-for="Descripcion" class="form-control" />
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PrecioPorDia" class="control-label"></label>
                <input asp-for="PrecioPorDia" class="form-control" />
                <span asp-validation-for="PrecioPorDia" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EstadoHerramienta" class="control-label"></label>
                <input asp-for="EstadoHerramienta" class="form-control" />
                <span asp-validation-for="EstadoHerramienta" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IdCategoria" class="control-label"></label>
                <select asp-for="IdCategoria" class ="form-control" asp-items="ViewBag.IdCategoria"></select>
            </div>
            <div class="form-group">
                <label asp-for="IdProveedor" class="control-label"></label>
                <select asp-for="IdProveedor" class ="form-control" asp-items="ViewBag.IdProveedor"></select>
            </div>
            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
</div>
<div class="view-actions"><a asp-action="Index">Volver al listado</a></div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}


